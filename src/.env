SERVER_PORT=8080

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Limite padrão por IP (requisições por segundo) e tempo de bloqueio em segundos
RATE_LIMIT_IP_MAX_REQUESTS=10
RATE_LIMIT_IP_BLOCK_DURATION_SECONDS=300

# Limite padrão para tokens sem regra específica em RATE_LIMIT_TOKEN_RULES
RATE_LIMIT_TOKEN_MAX_REQUESTS=100
RATE_LIMIT_TOKEN_BLOCK_DURATION_SECONDS=300

# Regras específicas por token: "token:limite:bloqueioSegundos;token2:limite:bloqueioSegundos"
RATE_LIMIT_TOKEN_RULES=abc123:100:300
